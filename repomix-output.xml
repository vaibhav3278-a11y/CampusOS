/* ======================================
   CampusOS
   Assignment Manager Pro
   Version : 2.0
====================================== */

/* ==========================
   Top Section
========================== */

.topbar{

    display:flex;

    justify-content:space-between;

    align-items:center;

    margin-bottom:30px;

}

/* ==========================
   Statistics
========================== */

.assignment-stats{

    display:grid;

    grid-template-columns:repeat(4,1fr);

    gap:20px;

    margin-bottom:30px;

}

.assignment-stats .stat-card{

    background:#fff;

    padding:25px;

    border-radius:18px;

    box-shadow:0 10px 25px rgba(0,0,0,.08);

    border:1px solid #ececec;

    transition:.3s;

}

.assignment-stats .stat-card:hover{

    transform:translateY(-5px);

}

.assignment-stats h4{

    color:#777;

    margin-bottom:10px;

    font-size:15px;

}

.assignment-stats h2{

    font-size:34px;

    color:#222;

}

/* ==========================
   Search
========================== */

.search-section{

    margin-bottom:30px;

}

.search-section input{

    width:100%;

}

/* ==========================
   Assignment Grid
========================== */

.assignment-list{

    display:grid;

    grid-template-columns:repeat(auto-fill,minmax(340px,1fr));

    gap:25px;

}

/* ==========================
   Assignment Card
========================== */

.assignment-card{

    background:#fff;

    border-radius:18px;

    padding:25px;

    box-shadow:0 10px 25px rgba(0,0,0,.08);

    transition:.3s;

    border:1px solid #ececec;

}

.assignment-card:hover{

    transform:translateY(-5px);

}

.assignment-top{

    display:flex;

    justify-content:space-between;

    align-items:center;

    margin-bottom:18px;

}

/* ==========================
   Priority Badges
========================== */

.priority{

    padding:6px 14px;

    border-radius:50px;

    font-size:13px;

    font-weight:700;

    color:#fff;

}

.priority.high{

    background:#EF4444;

}

.priority.medium{

    background:#F59E0B;

}

.priority.low{

    background:#22C55E;

}

/* ==========================
   Status
========================== */

.status{

    margin:18px 0;

    font-weight:600;

}

/* ==========================
   Buttons
========================== */

.action-buttons{

    display:flex;

    gap:10px;

    margin-top:20px;

}

.complete-btn{

    flex:1;

}

.delete-btn{

    flex:1;

}

.completed-card{

    opacity:.75;

    border-left:6px solid #22C55E;

}
/* ======================================
   Assignment Modal
====================================== */

.modal{

    position: fixed;

    inset: 0;

    background: rgba(0,0,0,.45);

    display: none;

    justify-content: center;

    align-items: center;

    z-index: 1000;

}

.modal.show{

    display: flex;

}

.modal-content{

    width: min(550px,90%);

    background: #fff;

    padding: 30px;

    border-radius: 20px;

    box-shadow: 0 20px 50px rgba(0,0,0,.2);

}

.modal-content h2{

    margin-bottom: 25px;

}

.input-group{

    display: flex;

    flex-direction: column;

    margin-bottom: 20px;

}

.input-group label{

    margin-bottom: 8px;

    font-weight: 600;

}

.input-group input,
.input-group select{

    width: 100%;

}

.modal-buttons{

    margin-top: 25px;

}
/* ======================================
   Assignments Dark Mode
====================================== */

body.dark .assignment-card{

    background: var(--surface);

    border: 1px solid var(--border);

    color: var(--text);

}

body.dark .assignment-card h1,
body.dark .assignment-card h2,
body.dark .assignment-card h3,
body.dark .assignment-card h4,
body.dark .assignment-card h5,
body.dark .assignment-card h6,
body.dark .assignment-card p,
body.dark .assignment-card span,
body.dark .assignment-card strong{

    color: var(--text);

}

body.dark .assignment-top{

    color: var(--text);

}

body.dark .status{

    color: var(--text);

}

body.dark .completed-card{

    background: var(--surface);

    border-left: 6px solid #22C55E;

}

body.dark .modal-content{

    background: var(--surface);

    color: var(--text);

}

body.dark .modal-content h2{

    color: var(--text);

}

body.dark .input-group label{

    color: var(--text);

}
