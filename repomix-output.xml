.status.interview {

    background: #FEF3C7;
    color: #B45309;

}

.status.hr {

    background: #FCE7F3;
    color: #BE185D;

}

.status.offer {

    background: #DCFCE7;
    color: #15803D;

}

.status.rejected {

    background: #FEE2E2;
    color: #DC2626;

}

.internship-info {

    display: grid;
    grid-template-columns: repeat(2,1fr);
    gap: 12px;

}

.info-item {

    color: #555;
    font-size: 14px;

}

.internship-actions {

    display: flex;
    gap: 10px;
    flex-wrap: wrap;
    margin-top: 10px;

}

textarea {

    width: 100%;
    padding: 14px;
    border: 1px solid var(--border);
    border-radius: 12px;
    resize: vertical;
    font-family: inherit;
    font-size: 15px;

}

.empty-state {

    text-align: center;
    padding: 60px 20px;
