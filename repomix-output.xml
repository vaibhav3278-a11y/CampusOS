// ======================================
// CampusOS
// Dashboard Intelligence v1.0
// ======================================

document.addEventListener("DOMContentLoaded", () => {

    NotificationManager.requestPermission();

    loadDashboard();

    NotificationManager.runDailyChecks();

});

// ======================================
// Profile
// ======================================

function loadProfile() {

    const profile = ProfileService.getProfile();

    const studentName = document.getElementById("studentName");

    if (!studentName) return;

    studentName.textContent =
        profile.fullName || "Student";

}

// ======================================
// Load Dashboard
// ======================================

function loadDashboard() {

    loadProfile();

    loadStatistics();

    loadTodayPlanner();

    loadUpcomingAssignments();

    loadInternshipWidget();

    loadAssistant();

    loadRecentActivity();

}

// ======================================
// Statistics
// ======================================

function loadStatistics() {

    const stats = DashboardService.getStatistics();

    document.getElementById("dashboardAssignments").textContent =
        stats.assignments.pending;

    document.getElementById("dashboardNotes").textContent =
        stats.notes.total;

    document.getElementById("dashboardInternships").textContent =
        stats.internships.total;

    

}

// ======================================
// Today's Planner
// ======================================

function loadTodayPlanner() {

    const list = document.getElementById("todayPlannerList");

    list.innerHTML = "";

    const today = DateUtils.today();

    const tasks = PlannerService
        .getAll()
        .filter(task =>
            task.date === today &&
            !task.completed
        );

    if (tasks.length === 0) {

        list.innerHTML = `
            <li>✔ No tasks scheduled for today.</li>
        `;

        return;

    }

    tasks.forEach(task => {

        list.innerHTML += `
            <li>${task.title}</li>
        `;

    });

}

// ======================================
// Upcoming Assignments
// ======================================

function loadUpcomingAssignments() {

    const list = document.getElementById("upcomingAssignments");

    list.innerHTML = "";

    const assignments = DashboardService.getUpcomingTasks();

    if (assignments.length === 0) {

        list.innerHTML = `
            <li>🎉 No upcoming assignments.</li>
        `;

        return;

    }

    assignments.forEach(item => {

        list.innerHTML += `
            <li>
                <strong>${item.title}</strong><br>
                Due : ${DateUtils.format(item.dueDate)}
            </li>
        `;

    });

}

// ======================================
// Internship Widget
// ======================================

function loadInternshipWidget() {

    const internships = InternshipService.getAll();

    document.getElementById("dashboardApplications").textContent =
        internships.length;

    document.getElementById("dashboardInterviews").textContent =
        internships.filter(i => i.status === "Interview").length;

    document.getElementById("dashboardOffers").textContent =
        internships.filter(i => i.status === "Offer").length;

}
// ======================================
// Recent Activity
// ======================================

function loadRecentActivity() {

    const list = document.getElementById("recentActivityList");

    if (!list) return;

    list.innerHTML = "";

    const activities = DashboardService.getRecentActivity();

    if (activities.length === 0) {

        list.innerHTML = `
            <li>No recent activity.</li>
        `;

        return;

    }

    activities.forEach(activity => {

        list.innerHTML += `
            <li>${activity.text}</li>
        `;

    });

}

// ======================================
// AI Assistant
// ======================================

function loadAssistant() {

    const greeting = document.getElementById("dashboardGreeting");
    const suggestion = document.getElementById("dashboardSuggestion");

    const profile = ProfileService.getProfile();

    const name = profile.fullName
        ? profile.fullName.split(" ")[0]
        : "Student";

    const hour = new Date().getHours();

    let message = "Good Evening";

    if (hour < 12) {

        message = "Good Morning";

    }
    else if (hour < 17) {

        message = "Good Afternoon";

    }

    greeting.textContent = `${message}, ${name} 👋`;

    const pendingAssignments =
        AssignmentService.getStatistics().pending;

    const todayTasks =
        PlannerService
            .getAll()
            .filter(task =>
                task.date === DateUtils.today() &&
                !task.completed
            ).length;

    const overdue =
        DashboardService.getOverdueAssignments().length;

    const productivity =
        DashboardService.getProductivity();

    let advice = [];

    if (overdue > 0) {

        advice.push(`🚨 ${overdue} overdue assignment(s).`);

    }

    if (pendingAssignments > 0) {

        advice.push(`📚 ${pendingAssignments} assignment(s) pending.`);

    }

    if (todayTasks > 0) {

        advice.push(`📅 ${todayTasks} planner task(s) today.`);

    }

    if (productivity >= 90) {

        advice.push("🔥 Excellent productivity today!");

    }
    else if (productivity >= 70) {

        advice.push("👍 You're making good progress.");

    }
    else {

        advice.push("💡 Focus on today's highest priority task.");

    }

    suggestion.textContent = advice.join(" ");

}
