// ======================================
// CampusOS
// Dashboard Service v2.0
// ======================================

const DashboardService = {

    // ================================
    // Dashboard Statistics
    // ================================

    getStatistics() {

        return {

            assignments: AssignmentService.getStatistics(),

            notes: NotesService.getStatistics(),

            internships: {

                total: InternshipService.getAll().length

            },

            placements: {

                total: PlacementService.getAll().length

            }

        };

    },

    // ================================
    // Upcoming Assignments
    // ================================

    getUpcomingTasks(limit = 5) {

        return AssignmentService
            .getAll()
            .filter(assignment => !assignment.completed)
            .sort((a, b) => new Date(a.dueDate) - new Date(b.dueDate))
            .slice(0, limit);

    },

    // ================================
    // Productivity
    // ================================

    getProductivity() {

        const assignments = AssignmentService.getStatistics();

        const planner = PlannerService.getStatistics();

        const total = assignments.total + planner.total;

        if (total === 0) {

            return 100;

        }

        const completed = assignments.completed + planner.completed;

        return Math.round((completed / total) * 100);

    },

    // ================================
    // Recent Activity
    // ================================

    getRecentActivity(limit = 5) {

        const activities = [];

        // Assignments
        AssignmentService.getAll().forEach(item => {

            activities.push({

                date: item.id,

                text: `📚 Assignment: ${item.title}`

            });

        });

        // Notes
        NotesService.getAll().forEach(item => {

            activities.push({

                date: item.id,

                text: `📝 Note: ${item.title}`

            });

        });

        // Planner
        PlannerService.getAll().forEach(item => {

            activities.push({

                date: item.id,

                text: `📅 Planner: ${item.title}`

            });

        });

        // Internship
        InternshipService.getAll().forEach(item => {

            activities.push({

                date: item.id,

                text: `💼 Internship: ${item.company}`

            });

        });

        // Placement
        PlacementService.getAll().forEach(item => {

            activities.push({

                date: item.id,

                text: `🎯 Placement: ${item.company}`

            });

        });

        return activities
            .sort((a, b) => b.date - a.date)
            .slice(0, limit);

    },

    // ================================
    // Overdue Assignments
    // ================================

    getOverdueAssignments() {

        return AssignmentService
            .getAll()
            .filter(item =>
                !item.completed &&
                DateUtils.isOverdue(item.dueDate)
            );

    }

};
