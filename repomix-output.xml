<file path="assets/css/components/modal.css">
/* ======================================
   CampusOS Design System
   Modal Component
   Version : 1.0
====================================== */

.modal{

    position: fixed;

    inset: 0;

    background: rgba(0,0,0,.55);

    display: none;

    justify-content: center;

    align-items: center;

    padding: 20px;

    overflow-y: auto;

    z-index: 9999;

}

.modal.show{

    display: flex;

}

.modal-content{

    background: #fff;

    width: 90%;

    max-width: 700px;

    border-radius: 20px;

    padding: 30px;

    box-shadow: 0 20px 50px rgba(0,0,0,.25);

    max-height: 90vh;

    overflow-y: auto;

    animation: modalPop .25s ease;

}

/* Scrollbar */

.modal-content::-webkit-scrollbar{

    width: 8px;

}

.modal-content::-webkit-scrollbar-thumb{

    background: #6366F1;

    border-radius: 20px;

}

.modal-content::-webkit-scrollbar-track{

    background: #F3F4F6;

}

/* Modal Header */

.modal-content h2{

    margin-bottom: 25px;

    font-size: 26px;

    font-weight: 700;

}

/* Form */

.input-group{

    display: flex;

    flex-direction: column;

    margin-bottom: 18px;

}

.input-group label{

    margin-bottom: 8px;

    font-weight: 600;

}

.input-group input,
.input-group select,
.input-group textarea{

    width: 100%;

    padding: 14px 16px;

    border: 1px solid #D1D5DB;

    border-radius: 12px;

    font-size: 15px;

    outline: none;

    transition: .25s;

    font-family: inherit;

}

.input-group input:focus,
.input-group select:focus,
.input-group textarea:focus{

    border-color: #4F46E5;

    box-shadow: 0 0 0 4px rgba(79,70,229,.12);

}

.input-group textarea{

    resize: vertical;

    min-height: 120px;

}

/* Footer Buttons */

.modal-buttons{

    display: flex;

    justify-content: flex-end;

    gap: 12px;

    margin-top: 25px;

}

/* Animation */

@keyframes modalPop{

    from{

        opacity:0;

        transform:scale(.95);

    }

    to{

        opacity:1;

        transform:scale(1);

    }

}
