const addNoteBtn = document.getElementById("addNoteBtn");
const noteModal = document.getElementById("noteModal");
const noteForm = document.getElementById("noteForm");
const notesList = document.getElementById("notesList");
const searchInput = document.getElementById("searchNote");
const cancelNoteBtn = document.getElementById("cancelNoteBtn");

let editingNoteId = null;

// ======================================
// Modal
// ======================================

Modal.bind("noteModal");

addNoteBtn.addEventListener("click", () => {

    editingNoteId = null;

    noteForm.reset();

    document.getElementById("noteModalTitle").textContent =
        "📝 New Note";

    Modal.open("noteModal");

});

cancelNoteBtn.addEventListener("click", () => {

    Modal.close("noteModal");

});

// ======================================
// Save / Update Note
// ======================================

noteForm.addEventListener("submit", function (e) {

    e.preventDefault();

    const title =
        document.getElementById("noteTitle").value.trim();

    const category =
        document.getElementById("noteCategory").value.trim();

    const content =
        document.getElementById("noteContent").value.trim();

    if (!Validator.required(title)) {

        Toast.error("Title is required");

        return;

    }

    if (!Validator.required(content)) {

        Toast.error("Please write your note");

        return;

    }

    const note = {

        id: editingNoteId || Date.now(),

        title,

        category,

        content,

        pinned: editingNoteId
            ? NotesService.getById(editingNoteId).pinned
            : false,

        createdAt: editingNoteId
            ? NotesService.getById(editingNoteId).createdAt
            : DateUtils.format(new Date())

    };

    if (editingNoteId) {

        NotesService.update(note);

        Toast.success("Note updated");

    } else {

        NotesService.add(note);

        Toast.success("Note created");

    }

    editingNoteId = null;

    noteForm.reset();

    Modal.close("noteModal");

    renderNotes(searchInput.value);

});

// ======================================
// Edit Note
// ======================================

function editNote(id) {

    const note = NotesService.duplicate(id);

    editingNoteId = id;

    document.getElementById("noteTitle").value =
        note.title;

    document.getElementById("noteCategory").value =
        note.category;

    document.getElementById("noteContent").value =
        note.content;

    document.getElementById("noteModalTitle").textContent =
        "✏ Edit Note";

    Modal.open("noteModal");

}
// ======================================
// Render Notes
// ======================================

function renderNotes(search = "") {

    let notes = NotesService.getAll();

    // Pinned notes first
    notes.sort((a, b) => Number(b.pinned) - Number(a.pinned));

    if (search) {

        const keyword = search.toLowerCase();

        notes = notes.filter(note =>

            note.title.toLowerCase().includes(keyword) ||
            note.category.toLowerCase().includes(keyword) ||
            note.content.toLowerCase().includes(keyword)

        );

    }

    notesList.innerHTML = "";

    if (notes.length === 0) {

        notesList.innerHTML = `

<div class="empty-state">

    <h3>📝 No Notes Found</h3>

    <p>Create your first smart note.</p>

</div>

`;

        updateStatistics();

        return;

    }

    notes.forEach(note => {

        notesList.innerHTML += `

<div class="note-card">

    <div class="note-top">

        <h3>${note.pinned ? "📌 " : ""}${note.title}</h3>

        <span class="note-category">

            ${note.category || "General"}

        </span>

    </div>

    <div class="note-content">

        ${note.content}

    </div>

    <small>

        📅 ${note.createdAt}

    </small>

    <div class="note-actions">

        <button
            class="btn btn-outline"
            onclick="togglePin(${note.id})">

            ${note.pinned ? "📍 Unpin" : "📌 Pin"}

        </button>

        <button
            class="btn btn-primary"
            onclick="editNote(${note.id})">

            ✏ Edit

        </button>

        <button
            class="btn btn-danger"
            onclick="deleteNote(${note.id})">

            🗑 Delete

        </button>

    </div>

</div>

`;

    });

    updateStatistics();

}

// ======================================
// Delete Note
// ======================================

function deleteNote(id) {

    NotesService.delete(id);

    Toast.success("Note deleted");

    renderNotes(searchInput.value);

}

// ======================================
// Pin / Unpin
// ======================================

function togglePin(id) {

    NotesService.togglePin(id);

    Toast.success("Note updated");

    renderNotes(searchInput.value);

}
// ======================================
// Statistics
// ======================================

function updateStatistics() {

    const stats = NotesService.getStatistics();

    document.getElementById("totalNotes").textContent =
        stats.total;

    document.getElementById("pinnedNotes").textContent =
        stats.pinned;

    document.getElementById("totalCategories").textContent =
        stats.categories;

}

// ======================================
// Search
// ======================================

searchInput.addEventListener("input", function () {

    renderNotes(this.value);

});

// ======================================
// Keyboard Shortcut
// Ctrl + N -> New Note
// ======================================

document.addEventListener("keydown", function (e) {

    if (e.ctrlKey && e.key.toLowerCase() === "n") {

        e.preventDefault();

        addNoteBtn.click();

    }

});

// ======================================
// Initial Load
// ======================================

renderNotes();

// ======================================
// Export (Future Ready)
// ======================================

window.editNote = editNote;
window.deleteNote = deleteNote;
window.togglePin = togglePin;
