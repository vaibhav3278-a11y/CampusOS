/*==========================
        AUTH PAGE
===========================*/

.auth{

    min-height:100vh;

    display:flex;

    justify-content:center;

    align-items:center;

    background:linear-gradient(135deg,#EEF2FF,#F8FAFC);

    padding:40px;

}

.auth-container{

    width:min(1200px,100%);

    background:white;

    border-radius:30px;

    overflow:hidden;

    display:grid;

    grid-template-columns:1fr 1fr;

    box-shadow:0 30px 80px rgba(0,0,0,.10);

}

.auth-left{

    background:linear-gradient(135deg,#5B5CEB,#7C83FF);

    color:white;

    padding:60px;

    display:flex;

    flex-direction:column;

    justify-content:center;

}

.auth-right{

    display:flex;

    justify-content:center;

    align-items:center;

    padding:60px;

}

.auth-card{

    width:100%;

    max-width:420px;

}
/*==========================
      AUTH CONTENT
===========================*/

.logo{

    display:flex;

    align-items:center;

    gap:15px;

    margin-bottom:40px;

}

.logo-icon{

    width:55px;

    height:55px;

    border-radius:15px;

    background:rgba(255,255,255,.20);

    display:flex;

    justify-content:center;

    align-items:center;

    font-size:28px;

}

.auth-left h1{

    font-size:52px;

    margin-bottom:20px;

    line-height:1.1;

}

.auth-left p{

    font-size:18px;

    line-height:1.8;

    opacity:.95;

    margin-bottom:40px;

}

.auth-image{

    width:180px;

    height:180px;

    border-radius:50%;

    background:rgba(255,255,255,.15);

    display:flex;

    justify-content:center;

    align-items:center;

    font-size:80px;

}

.auth-card h2{

    font-size:38px;

    margin-bottom:10px;

    color:var(--dark);

}

.auth-card p{

    color:var(--text);

    margin-bottom:35px;

}
/*==========================
      LOGIN FORM
===========================*/

.input-group{

    display:flex;

    flex-direction:column;

    margin-bottom:22px;

}

.input-group label{

    font-weight:600;

    margin-bottom:10px;

    color:var(--dark);

}

.input-group input{

    width:100%;

    padding:16px 18px;

    border:1px solid var(--border);

    border-radius:14px;

    font-size:16px;

    transition:var(--transition);

    background:#FAFBFF;

}

.input-group input:focus{

    outline:none;

    border-color:var(--primary);

    box-shadow:0 0 0 4px rgba(91,92,235,.15);

}

.forgot{

    display:block;

    text-align:right;

    margin-bottom:25px;

    color:var(--primary);

    font-size:15px;

    font-weight:600;

}

.start-btn{

    width:100%;

    padding:16px;

    border:none;

    border-radius:14px;

    background:var(--primary);

    color:white;

    font-size:17px;

    font-weight:700;

    cursor:pointer;

    transition:var(--transition);

}

.start-btn:hover{

    transform:translateY(-3px);

    box-shadow:0 15px 30px rgba(91,92,235,.35);

}
/*==========================
      EXTRA LOGIN UI
===========================*/

.divider{

    display:flex;

    align-items:center;

    margin:30px 0;

    color:var(--text);

    font-size:14px;

}

.divider::before,
.divider::after{

    content:"";

    flex:1;

    height:1px;

    background:var(--border);

}

.divider::before{

    margin-right:15px;

}

.divider::after{

    margin-left:15px;

}

.google-btn{

    width:100%;

    padding:15px;

    background:white;

    border:1px solid var(--border);

    border-radius:14px;

    font-size:16px;

    font-weight:600;

    transition:var(--transition);

}

.google-btn:hover{

    background:#F8FAFC;

    border-color:var(--primary);

}

.bottom-text{

    text-align:center;

    margin-top:30px;

    color:var(--text);

}

.bottom-text a{

    color:var(--primary);

    font-weight:700;

}
/*==========================
      RESPONSIVE LOGIN
===========================*/

@media(max-width:900px){

    .auth-container{

        grid-template-columns:1fr;

    }

    .auth-left{

        display:none;

    }

    .auth-right{

        padding:40px 25px;

    }

}
