// ======================================
// CampusOS
// Settings Page v1.0
// ======================================

const darkModeCheckbox = document.getElementById("darkMode");
const notificationsCheckbox = document.getElementById("notifications");
const autoSaveCheckbox = document.getElementById("autoSave");

const exportBtn = document.getElementById("exportBtn");
const importBtn = document.getElementById("importBtn");
const importFile = document.getElementById("importFile");

const resetSettingsBtn = document.getElementById("resetSettingsBtn");
const clearDataBtn = document.getElementById("clearDataBtn");

// ======================================
// Load Settings
// ======================================

function loadSettings() {

    const settings = SettingsService.getSettings();

    darkModeCheckbox.checked = settings.darkMode;
    notificationsCheckbox.checked = settings.notifications;
    autoSaveCheckbox.checked = settings.autoSave;

}

// ======================================
// Save Settings
// ======================================

function saveSettings() {

    const settings = {

        darkMode: darkModeCheckbox.checked,

        notifications: notificationsCheckbox.checked,

        autoSave: autoSaveCheckbox.checked

    };

    SettingsService.saveSettings(settings);
    Theme.init();
    Toast.success("Settings saved successfully.");

}

// ======================================
// Auto Save
// ======================================

darkModeCheckbox.addEventListener("change", saveSettings);

notificationsCheckbox.addEventListener("change", saveSettings);

autoSaveCheckbox.addEventListener("change", saveSettings);

// ======================================
// Export Data
// ======================================

exportBtn.addEventListener("click", function () {

    const data = {

        assignments: localStorage.getItem("assignments"),

        notes: localStorage.getItem("notes"),

        planner: localStorage.getItem("planner"),

        internships: localStorage.getItem("internships"),

        placements: localStorage.getItem("placements"),

        profile: localStorage.getItem("profile"),

        settings: localStorage.getItem("settings")

    };

    const blob = new Blob(

        [JSON.stringify(data, null, 2)],

        { type: "application/json" }

    );

    const link = document.createElement("a");

    link.href = URL.createObjectURL(blob);

    link.download = "CampusOS_Backup.json";

    link.click();

    Toast.success("Backup exported successfully.");

});

// ======================================
// Import Data
// ======================================

importBtn.addEventListener("click", function () {

    importFile.click();

});

importFile.addEventListener("change", function () {

    const file = this.files[0];

    if (!file) return;

    const reader = new FileReader();

    reader.onload = function (e) {

        try {

            const data = JSON.parse(e.target.result);

            Object.keys(data).forEach(key => {

                if (data[key] !== null) {

                    localStorage.setItem(key, data[key]);

                }

            });

            Toast.success("Backup imported successfully.");

            setTimeout(() => {

                location.reload();

            }, 800);

        }

        catch {

            Toast.error("Invalid backup file.");

        }

    };

    reader.readAsText(file);

});

// ======================================
// Reset Settings
// ======================================

resetSettingsBtn.addEventListener("click", function () {

    if (!confirm("Reset all settings?")) {

        return;

    }

    SettingsService.resetSettings();

    loadSettings();
    Theme.init();
    Toast.info("Settings reset successfully.");

});

// ======================================
// Clear All Data
// ======================================

clearDataBtn.addEventListener("click", function () {

    const confirmDelete = confirm(

        "This will permanently delete ALL CampusOS data.\n\nContinue?"

    );

    if (!confirmDelete) {

        return;

    }

    localStorage.clear();

    Toast.success("All data cleared.");

    setTimeout(() => {

        location.reload();

    }, 800);

});

// ======================================
// Initial Load
// ======================================

loadSettings();
